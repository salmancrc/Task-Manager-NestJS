generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User Model
model User {
  id          Int           @id @default(autoincrement())
  email       String        @unique
  name        String?      
  tasks       Task[]
}

// Task Model
model Task {
  id          Int           @id @default(autoincrement())
  title       String
  completed   Boolean       @default(false)
  userId      Int?
  user        User?         @relation(fields: [userId], references: [id])
}
